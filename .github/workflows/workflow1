name: AI Subtitle Generator

on:
  push:
    paths:
      - data/audio/*.m4a
      - data/audio/*.mp3
      - data/audio/*.wav
  workflow_dispatch:
  repository_dispatch:
    types:
      - process_audio
      - process_drive_audio
      - new_drive_file

permissions:
  contents: write
  packages: read

jobs:
  process:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
    
    # 👈 ĐỊNH NGHĨA TÊN IMAGE (CHỮ THƯỜNG)
    - name: Set image name
      id: image
      run: |
        echo "image=ghcr.io/${{ github.repository_owner }}/subtitle-ai" | tr '[:upper:]' '[:lower:]' >> $GITHUB_OUTPUT
        echo "✅ Image: ${{ steps.image.outputs.image }}"
    
    # 👈 HIỂN THỊ PAYLOAD NHẬN ĐƯỢC
    - name: Show received payload
      run: |
        echo "📦 Event: ${{ github.event.action }}"
        echo "📁 File ID: ${{ github.event.client_payload.drive_file_id }}"
        echo "📄 File Name: ${{ github.event.client_payload.file_name }}"
        echo "🎯 Video ID: ${{ github.event.client_payload.video_id }}"
        echo "📌 Has video_id: ${{ github.event.client_payload.has_video_id }}"
        echo "🔍 Search by name: ${{ github.event.client_payload.search_by_name }}"
        echo "⏰ Timestamp: ${{ github.event.client_payload.timestamp }}"
    
    # 👈 KIỂM TRA TOKEN
    - name: Debug - Check HF_TOKEN on runner
      run: |
        if [ -n "$HF_TOKEN" ]; then
          echo "✅ HF_TOKEN is set on runner (length: ${#HF_TOKEN})"
          echo "✅ Token prefix: ${HF_TOKEN:0:10}..."
        else
          echo "❌ HF_TOKEN is NOT set on runner!"
        fi
      env:
        HF_TOKEN: ${{ secrets.HF_TOKEN }}
    
    # 👈 TẠO LOCK (DÙNG TÊN FILE GỐC HOẶC VIDEO_ID)
    - name: Create processing lock
      env:
        FILE_NAME: ${{ github.event.client_payload.file_name }}
        VIDEO_ID: ${{ github.event.client_payload.video_id }}
      run: |
        mkdir -p .processing
        LOCK_NAME="${FILE_NAME:-$VIDEO_ID}"
        if [ -z "$LOCK_NAME" ]; then
          echo "⚠️ No file name or video ID, skipping lock"
          exit 0
        fi
        echo "$(date -u '+%Y-%m-%d %H:%M:%S UTC')" > ".processing/${LOCK_NAME}.lock"
        git config user.name "Actions"
        git config user.email "actions@github.com"
        git add .processing/
        git diff --staged --quiet || (git commit -m "Lock: Processing ${LOCK_NAME}" && git push) || echo "Lock already exists"
    
    # 👈 TẢI TỪ GOOGLE DRIVE (GIỮ TÊN GỐC)
    - name: Download from Google Drive
      id: download
      if: github.event.action == 'process_drive_audio' || github.event.action == 'new_drive_file' || github.event.client_payload.drive_file_id
      env:
        DRIVE_FILE_ID: ${{ github.event.client_payload.drive_file_id }}
        FILE_NAME: ${{ github.event.client_payload.file_name }}
        VIDEO_ID: ${{ github.event.client_payload.video_id }}
      run: |
        pip install gdown
        mkdir -p data/audio
        
        # 👈 ƯU TIÊN DÙNG TÊN GỐC, NẾU KHÔNG CÓ THÌ DÙNG VIDEO_ID
        if [ -n "$FILE_NAME" ]; then
          AUDIO_NAME="$FILE_NAME"
        else
          AUDIO_NAME="${VIDEO_ID:-unknown}.m4a"
        fi
        
        echo "📥 Downloading from Google Drive..."
        echo "File ID: $DRIVE_FILE_ID"
        echo "File Name: $AUDIO_NAME"
        
        gdown "https://drive.google.com/uc?id=${DRIVE_FILE_ID}" -O "data/audio/${AUDIO_NAME}"
        
        if [ -f "data/audio/${AUDIO_NAME}" ]; then
          echo "✅ Downloaded: ${AUDIO_NAME}"
          echo "file_name=${AUDIO_NAME}" >> $GITHUB_OUTPUT
          echo "name_without_ext=${AUDIO_NAME%.*}" >> $GITHUB_OUTPUT
        else
          echo "❌ Download failed!"
          exit 1
        fi
    
    - name: Login to GitHub Container Registry
      uses: docker/login-action@v3
      with:
        registry: ghcr.io
        username: ${{ github.actor }}
        password: ${{ secrets.GITHUB_TOKEN }}
    
    - name: Pull AI Docker image
      run: |
        docker pull ${{ steps.image.outputs.image }}:latest || true
        echo "✅ Docker image ready"
    
    # 👈 XỬ LÝ AUDIO VỚI AI
    - name: Process audio with AI
      id: process
      env:
        HF_TOKEN: ${{ secrets.HF_TOKEN }}
        FILE_NAME: ${{ steps.download.outputs.file_name }}
        NAME_WITHOUT_EXT: ${{ steps.download.outputs.name_without_ext }}
        VIDEO_ID_OVERRIDE: ${{ github.event.client_payload.video_id }}
        HAS_VIDEO_ID: ${{ github.event.client_payload.has_video_id }}
        SEARCH_BY_NAME: ${{ github.event.client_payload.search_by_name }}
      run: |
        # 👈 TÌM FILE AUDIO
        if [ -n "$FILE_NAME" ]; then
          AUDIO_FILE="data/audio/${FILE_NAME}"
        else
          AUDIO_FILE=$(find data/audio -type f \( -name "*.m4a" -o -name "*.mp3" -o -name "*.wav" \) | head -1)
        fi
        
        if [ -z "$AUDIO_FILE" ] || [ ! -f "$AUDIO_FILE" ]; then
          echo "❌ No audio file found!"
          echo "has_audio=false" >> $GITHUB_OUTPUT
          exit 1
        fi
        
        # 👈 LẤY TÊN GỐC (KHÔNG EXTENSION)
        FILE_NAME=$(basename "$AUDIO_FILE")
        if [ -z "$NAME_WITHOUT_EXT" ]; then
          NAME_WITHOUT_EXT="${FILE_NAME%.*}"
        fi
        
        echo "🎬 Processing: $FILE_NAME"
        echo "📝 Output name: $NAME_WITHOUT_EXT"
        echo "🎯 VIDEO_ID_OVERRIDE: $VIDEO_ID_OVERRIDE"
        echo "📌 HAS_VIDEO_ID: $HAS_VIDEO_ID"
        echo "🔍 SEARCH_BY_NAME: $SEARCH_BY_NAME"
        
        mkdir -p output
        
        echo "📁 Running Docker container with HF_TOKEN..."
        
        # 👈 QUYẾT ĐỊNH CÁCH GỌI SCRIPT
        if [ -n "$VIDEO_ID_OVERRIDE" ] && [ "$HAS_VIDEO_ID" = "true" ]; then
          echo "✅ Sử dụng Video ID từ payload: $VIDEO_ID_OVERRIDE"
          echo "📌 KHÔNG tìm kiếm trên YouTube"
          
          docker run --rm \
            -v $(pwd):/app \
            -w /app \
            -e HF_TOKEN="${{ secrets.HF_TOKEN }}" \
            -e VIDEO_ID_OVERRIDE="$VIDEO_ID_OVERRIDE" \
            ${{ steps.image.outputs.image }}:latest \
            bash -c "
              echo '🎯 Dùng Video ID từ payload (KHÔNG tìm kiếm)'
              echo '✅ HF_TOKEN inside container: length='\${#HF_TOKEN}
              python scripts/generate_subtitles.py --audio '/app/$AUDIO_FILE' --video-id '$VIDEO_ID_OVERRIDE'
            "
        else
          echo "🔍 Không có Video ID, tìm kiếm trên YouTube theo tên file"
          
          docker run --rm \
            -v $(pwd):/app \
            -w /app \
            -e HF_TOKEN="${{ secrets.HF_TOKEN }}" \
            ${{ steps.image.outputs.image }}:latest \
            bash -c "
              echo '🔍 Tìm kiếm YouTube theo tên file'
              echo '✅ HF_TOKEN inside container: length='\${#HF_TOKEN}
              python scripts/generate_subtitles.py --audio '/app/$AUDIO_FILE'
            "
        fi
        
        echo "📁 Checking output files:"
        ls -la output/
        
        # 👈 ĐỌC CLEAN_NAME TỪ video_id.env (AN TOÀN - KHÔNG DÙNG SOURCE)
        if [ -f "video_id.env" ]; then
          echo "📄 Reading video_id.env (safe)..."
          
          # 👈 Đọc từng dòng an toàn
          while IFS= read -r line || [ -n "$line" ]; do
            # Bỏ qua dòng trống và dòng comment
            [[ -z "$line" || "$line" =~ ^# ]] && continue
            # Lấy tên biến và giá trị
            if [[ "$line" =~ ^([A-Z_]+)=\"?(.*)\"?$ ]]; then
              var_name="${BASH_REMATCH[1]}"
              var_value="${BASH_REMATCH[2]}"
              # Loại bỏ dấu ngoặc kép thừa
              var_value="${var_value%\"}"
              var_value="${var_value#\"}"
              # Gán biến
              declare "$var_name=$var_value"
              echo "✅ Set $var_name"
            fi
          done < video_id.env
          
          # 👈 Xuất ra GITHUB_OUTPUT
          if [ -n "$CLEAN_NAME" ]; then
            echo "clean_name=$CLEAN_NAME" >> $GITHUB_OUTPUT
            echo "✅ CLEAN_NAME: $CLEAN_NAME"
          fi
          if [ -n "$VIDEO_ID" ]; then
            echo "video_id=$VIDEO_ID" >> $GITHUB_OUTPUT
            echo "✅ VIDEO_ID: $VIDEO_ID"
          fi
          if [ -n "$YOUTUBE_LINK" ]; then
            echo "youtube_link=$YOUTUBE_LINK" >> $GITHUB_OUTPUT
            echo "✅ YOUTUBE_LINK: $YOUTUBE_LINK"
          fi
        else
          echo "⚠️ video_id.env not found"
        fi
        
        # 👈 KIỂM TRA FILE VTT
        VTT_FILE=$(find output -name "*.vtt" | head -1)
        if [ -f "$VTT_FILE" ]; then
          VTT_NAME=$(basename "$VTT_FILE" .vtt)
          echo "✅ Processing completed: $VTT_NAME"
          echo "has_audio=true" >> $GITHUB_OUTPUT
          echo "name_without_ext=$VTT_NAME" >> $GITHUB_OUTPUT
          
          # 👈 NẾU CHƯA CÓ CLEAN_NAME, DÙNG VTT_NAME
          if [ -z "$CLEAN_NAME" ]; then
            echo "clean_name=$VTT_NAME" >> $GITHUB_OUTPUT
          fi
        else
          echo "❌ VTT file NOT created!"
          echo "has_audio=false" >> $GITHUB_OUTPUT
          exit 1
        fi
    
    # ===== UPLOAD SUBTITLE TO GIST =====
    - name: Upload subtitle to Gist
      id: upload_gist
      if: steps.process.outputs.has_audio == 'true'
      env:
        GIST_TOKEN: ${{ secrets.GIST_TOKEN }}
        GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        VIDEO_ID: ${{ steps.process.outputs.video_id }}
        FILE_NAME: ${{ steps.process.outputs.file_name }}
        NAME_WITHOUT_EXT: ${{ steps.process.outputs.name_without_ext }}
        YOUTUBE_LINK: ${{ steps.process.outputs.youtube_link }}
        CLEAN_NAME: ${{ steps.process.outputs.clean_name }}
      run: |
        echo "📤 Uploading subtitle to Gist..."
        echo "📁 Files in output:"
        ls -la output/
        echo "🎯 Video ID: $VIDEO_ID"
        echo "📝 Clean Name: $CLEAN_NAME"
        echo "🔗 YouTube: $YOUTUBE_LINK"
        
        # 👈 KIỂM TRA FILE VTT
        if [ -n "$CLEAN_NAME" ] && [ -f "output/${CLEAN_NAME}.vtt" ]; then
          echo "✅ Found VTT with clean_name: ${CLEAN_NAME}.vtt"
        elif [ -f "output/${NAME_WITHOUT_EXT}.vtt" ]; then
          echo "✅ Found VTT with name_without_ext: ${NAME_WITHOUT_EXT}.vtt"
          # Nếu không có CLEAN_NAME, dùng NAME_WITHOUT_EXT
          if [ -z "$CLEAN_NAME" ]; then
            CLEAN_NAME="$NAME_WITHOUT_EXT"
            echo "📝 Using NAME_WITHOUT_EXT as CLEAN_NAME: $CLEAN_NAME"
          fi
        else
          echo "❌ VTT file not found!"
          exit 1
        fi
        
        # 👈 CHẠY SCRIPT UPLOAD
        python scripts/push_to_gist.py
        
        if [ $? -eq 0 ]; then
          echo "✅ Upload to Gist successful!"
          echo "gist_uploaded=true" >> $GITHUB_OUTPUT
        else
          echo "❌ Upload to Gist FAILED!"
          echo "gist_uploaded=false" >> $GITHUB_OUTPUT
          exit 1
        fi
    
    # ===== XÓA FILE TRÊN GOOGLE DRIVE =====
    - name: Delete file from Google Drive (OAuth)
      if: |
        steps.upload_gist.outputs.gist_uploaded == 'true' && 
        (github.event.action == 'process_drive_audio' || github.event.action == 'new_drive_file')
      env:
        DRIVE_FILE_ID: ${{ github.event.client_payload.drive_file_id }}
        OAUTH_CLIENT_ID: ${{ secrets.OAUTH_CLIENT_ID }}
        OAUTH_CLIENT_SECRET: ${{ secrets.OAUTH_CLIENT_SECRET }}
        OAUTH_REFRESH_TOKEN: ${{ secrets.OAUTH_REFRESH_TOKEN }}
        VIDEO_ID: ${{ steps.process.outputs.video_id }}
      run: |
        echo "🗑️ Deleting file from Google Drive using OAuth..."
        echo "📹 Video ID: $VIDEO_ID"
        echo "📎 File ID: $DRIVE_FILE_ID"
        
        if [ -z "$OAUTH_CLIENT_ID" ] || [ -z "$OAUTH_CLIENT_SECRET" ] || [ -z "$OAUTH_REFRESH_TOKEN" ]; then
          echo "⚠️ OAuth credentials not configured, skipping delete"
          exit 0
        fi
        
        cat > /tmp/delete_oauth.py << 'EOF'
        import os, sys
        from google.oauth2.credentials import Credentials
        from google.auth.transport.requests import Request
        from googleapiclient.discovery import build
        from googleapiclient.errors import HttpError

        def delete_file_with_oauth(file_id, client_id, client_secret, refresh_token):
            try:
                creds = Credentials(
                    None,
                    refresh_token=refresh_token,
                    client_id=client_id,
                    client_secret=client_secret,
                    token_uri='https://oauth2.googleapis.com/token'
                )
                creds.refresh(Request())
                service = build('drive', 'v3', credentials=creds)
                print(f"🗑️ Deleting file: {file_id}")
                service.files().delete(fileId=file_id, supportsAllDrives=True).execute()
                print(f"✅ File {file_id} deleted successfully!")
                return True
            except HttpError as error:
                if error.resp.status == 404:
                    print(f"⚠️ File {file_id} not found (already deleted)")
                    return True
                print(f"❌ Google API error: {error}")
                return False
            except Exception as error:
                print(f"❌ Unexpected error: {error}")
                return False

        def main():
            file_id = os.getenv('DRIVE_FILE_ID')
            client_id = os.getenv('OAUTH_CLIENT_ID')
            client_secret = os.getenv('OAUTH_CLIENT_SECRET')
            refresh_token = os.getenv('OAUTH_REFRESH_TOKEN')
            
            if not all([file_id, client_id, client_secret, refresh_token]):
                print("❌ Missing OAuth credentials")
                sys.exit(1)
            
            success = delete_file_with_oauth(file_id, client_id, client_secret, refresh_token)
            sys.exit(0 if success else 1)

        if __name__ == "__main__":
            main()
        EOF
        
        pip install google-api-python-client google-auth-oauthlib google-auth-httplib2
        python3 /tmp/delete_oauth.py
        
        if [ $? -eq 0 ]; then
          echo "✅ File deleted successfully from Google Drive!"
        else
          echo "❌ Failed to delete file!"
          exit 1
        fi
    
    # 👈 XÓA LOCK
    - name: Remove processing lock
      if: always()
      env:
        FILE_NAME: ${{ steps.process.outputs.file_name }}
        VIDEO_ID: ${{ steps.process.outputs.video_id }}
      run: |
        LOCK_NAME="${FILE_NAME:-$VIDEO_ID}"
        if [ -n "$LOCK_NAME" ]; then
          rm -f ".processing/${LOCK_NAME}.lock"
          git config user.name "Actions"
          git config user.email "actions@github.com"
          git add .processing/
          git diff --staged --quiet || (git commit -m "Unlock: ${LOCK_NAME}" && git push) || echo "No lock to remove"
        fi
    
    - name: Cleanup
      if: always()
      run: |
        rm -f data/audio/*.m4a data/audio/*.mp3 data/audio/*.wav 2>/dev/null || true
        touch data/audio/.gitkeep
        rm -f output/*.vtt output/*_summary.json output/*.info.txt 2>/dev/null || true
        touch output/.gitkeep
        echo "✅ Cleaned up"
        
        git config user.name "Actions"
        git config user.email "actions@github.com"
        git add -A
        git diff --staged --quiet || (git commit -m "Cleanup [skip ci]" && git push) || echo "Push skipped"
