name: AI Subtitle Generator

on:
  push:
    paths:
      - data/audio/*.m4a
  workflow_dispatch:
  repository_dispatch:
    types:
      - process_audio

permissions:
  contents: write
  packages: read

jobs:
  generate:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    
    steps:
    - uses: actions/checkout@v4
    
    - name: Login to GitHub Container Registry
      uses: docker/login-action@v3
      with:
        registry: ghcr.io
        username: ${{ github.actor }}
        password: ${{ secrets.GITHUB_TOKEN }}
    
    - name: Pull AI Docker image
      run: |
        docker pull ghcr.io/pinyincode/subtitle-ai:latest || true
        echo "✅ Docker image ready"
    
    - name: Process audio with AI
      run: |
        # Tìm file audio mới nhất
        AUDIO_FILE=$(find data/audio -name "*.m4a" -type f | head -1)
        
        if [ -n "$AUDIO_FILE" ]; then
          VIDEO_ID=$(basename "$AUDIO_FILE" .m4a)
          echo "🎬 Processing: $VIDEO_ID"
          
          # Chạy Docker với script của bạn
          docker run --rm \
            -v $(pwd):/app \
            -w /app \
            ghcr.io/pinyincode/subtitle-ai:latest \
            python scripts/generate_subtitles.py \
            --audio "/app/$AUDIO_FILE" \
            --output "/app/output/${VIDEO_ID}.vtt"
          
          echo "✅ Processing completed"
        else
          echo "ℹ️ No audio file found"
        fi
    
    - name: Upload to Gist
      if: always()
      env:
        GH_TOKEN: ${{ secrets.GIST_TOKEN }}
      run: |
        python scripts/push_to_gist.py 2>/dev/null || echo "Gist skipped"
    
    - name: Cleanup
      if: always()
      run: |
        rm -f data/audio/*.m4a
        touch data/audio/.gitkeep
        
        git config user.name "Actions"
        git config user.email "actions@github.com"
        git add -A
        git diff --staged --quiet || (git commit -m "Cleanup [skip ci]" && git push) || echo "Push skipped"
